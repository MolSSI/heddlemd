/.riprap/podman/agent-build.candidate.env

# Agent credentials (integration settings and skill adapters remain trackable)
/.codex/auth.json
/.claude/.credentials.json
/.claude.json
/.env
/.env.local
/.env.*.local

/target

# Simulation output
*.out.*.xyz
*.out.*.log
*.out.*.timings
*.out.*.minlog

# Analysis output (`dynamics analyze` writes `<root>.out.<name>.csv`).
*.out.*.csv

# mdBook build output
book/book/
